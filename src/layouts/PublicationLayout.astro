---
import PublicationHeader from '../components/navigation/PublicationHeader.astro';
import GlossaryDialog from '../components/glossary/GlossaryDialog.astro';
import type { Glossary } from '../lib/content/schemas';
import { route } from '../lib/routes';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/publication.css';
import '../styles/navigation.css';
import '../styles/cases.css';
import '../styles/explainers.css';
import '../styles/figures.css';
import '../styles/reading.css';
import '../styles/reading-type-ramp.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  currentLabel: string;
  currentPath: string;
  glossary?: Glossary;
}
const { title, description, currentLabel, currentPath, glossary } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1c1d" />
    <link rel="icon" href={route('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <PublicationHeader currentLabel={currentLabel} currentPath={currentPath} />
    <main id="main-content"><slot /></main>
    <footer class="publication-footer">
      <div>
        <strong>Ares</strong>
        <span>Extreme Mass Homicide · An analytical synopsis</span>
      </div>
      <nav aria-label="Research utilities">
        <a href={route('/glossary')}>Glossary</a>
        <a href={route('/references')}>References</a>
      </nav>
    </footer>
    {glossary && <GlossaryDialog glossary={glossary} />}
    <script>
      import '../scripts/reading-progress';
    </script>
  </body>
</html>
