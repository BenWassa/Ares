---
import PublicationHeader from '../components/navigation/PublicationHeader.astro';
import GlossaryDialog from '../components/glossary/GlossaryDialog.astro';
import type { Glossary } from '../lib/content/schemas';
import { route } from '../lib/routes';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/publication.css';
import '../styles/navigation.css';
import '../styles/cases.css';
import '../styles/explainers.css';
import '../styles/figures.css';
import '../styles/reading.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description: string;
  currentLabel: string;
  currentPath: string;
  glossary?: Glossary;
  surface?: 'home' | 'publication';
}
const { title, description, currentLabel, currentPath, glossary, surface = 'publication' } = Astro.props;
// One ground, one browser chrome colour: the publication does not change
// register between its cover and its chapters.
const themeColor = '#0a0806';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Project Ares" />
    <meta name="generator" content="Astro" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content={themeColor} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('has-js');</script>
  </head>
  <body class={`ares-surface-${surface}`}>
    <a class="skip-link" href="#main-content">
      {surface === 'home' ? 'Skip to entry options' : 'Skip to publication'}
    </a>
    {surface === 'publication' && <PublicationHeader currentLabel={currentLabel} currentPath={currentPath} />}
    <main id="main-content" tabindex="-1"><slot /></main>
    {surface === 'publication' && (
      <footer class="site-footer">
        <a href={route('/')}>Ares</a>
        <p>An evidence-led digital publication interpreting Dutton, Boyanowsky &amp; Bond (2005).</p>
        <nav aria-label="Reference links"><a href={route('/glossary')}>Glossary</a><a href={route('/references')}>Sources &amp; provenance</a></nav>
      </footer>
    )}
    {glossary && <GlossaryDialog glossary={glossary} />}
    {glossary && <script>import '../scripts/glossary';</script>}
    <script>import '../scripts/reading-progress';</script>
  </body>
</html>
