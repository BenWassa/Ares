---
import type { Glossary as GlossaryType } from '../../lib/content/schemas';
interface Props { glossary: GlossaryType }
const { glossary } = Astro.props;
const entries = Object.entries(glossary).sort(([, a], [, b]) => a.term.localeCompare(b.term));
---
<section id="glossary" class="appendix-section" aria-labelledby="glossary-title">
  <p class="part-title">Appendix</p>
  <h2 id="glossary-title">Glossary</h2>
  <div class="glossary-list">
    {entries.map(([key, entry]) => (
      <article id={`glossary-${key}`} class="glossary-entry">
        <h3>{entry.term}</h3>
        <p>{entry.definition}</p>
        <p class="glossary-extended">{entry.extendedDefinition}</p>
        {entry.sourceNote && <p class="source-note">Source context: {entry.sourceNote}</p>}
      </article>
    ))}
  </div>
</section>
<dialog id="glossary-dialog" class="glossary-dialog" aria-labelledby="glossary-dialog-title">
  <form method="dialog"><button id="glossary-dialog-close" value="close" aria-label="Close definition">Close</button></form>
  <p class="section-kicker">Glossary definition</p>
  <h2 id="glossary-dialog-title"></h2>
  <p id="glossary-dialog-short"></p>
  <p id="glossary-dialog-extended"></p>
  <p id="glossary-dialog-source" class="source-note"></p>
  <p id="glossary-dialog-related"></p>
  <a id="glossary-dialog-full-link" href="#glossary">Read in full glossary</a>
</dialog>
<script is:inline define:vars={{ glossary }}>
  window.ARES_GLOSSARY = glossary;
</script>
