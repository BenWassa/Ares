---
import { publicationRoutes, route } from '../../lib/routes';

interface Props {
  currentLabel: string;
  currentPath: string;
}

const { currentLabel, currentPath } = Astro.props;
const isCurrent = (path: string) => currentPath === path || (path === '/cases' && currentPath.startsWith('/cases/'));
---
<header class="publication-header">
  <div class="publication-header__bar">
    <a class="reader-mark" href={route('/')} aria-label="Project Ares, publication home">Ares</a>
    <p class="publication-location">{currentLabel}</p>
    <details class="publication-contents" id="publication-contents">
      <summary>Contents</summary>
      <nav aria-label="Publication contents">
        <ul>
          <li><a href={route('/')} aria-current={currentPath === '/' ? 'page' : undefined}>Opening</a></li>
          {publicationRoutes.map((item) => (
            <li>
              <a href={route(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
                <span class="contents-label">{item.label}</span><span class="contents-numeral">{item.numeral}</span>{item.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style is:global>
  /* With no JavaScript, mobile starts with the native disclosure closed. Desktop
     still exposes the same list as the persistent masthead navigation. */
  @media (min-width: 76rem) {
    html:not(.has-js) .publication-header .publication-contents:not([open]) > nav { display: block; }
  }
</style>
<script>import '../../scripts/publication-contents';</script>
