---
import Chronology from './Chronology.astro';
import type { CaseRecord, Glossary } from '../../lib/content/schemas';
import { loadCaseDocument } from '../../lib/content/case-document';
import { evidenceKindLabel, quotationStatusLabel, sourceStatusLabel } from '../../lib/content/labels';
import { caseRoute, route } from '../../lib/routes';

interface Props {
  record: CaseRecord;
  glossary: Glossary;
  previous: CaseRecord | null;
  next: CaseRecord | null;
  standalone?: boolean;
  glossaryHrefPrefix?: string;
  linkMode?: 'routes' | 'fragments';
}
const { record, glossary, previous, next, standalone = false, glossaryHrefPrefix = '#glossary-', linkMode = 'routes' } = Astro.props;
const document = await loadCaseDocument(record, glossary, { glossaryHrefPrefix });
const caseHref = (item: CaseRecord) => linkMode === 'fragments' ? `#${item.id}` : caseRoute(item.id);
const sectionClass = { narrative: 'narrative-section', analysis: 'analytical-section', chronology: 'chronology-section', evidence: 'evidence-section' } as const;
---
<article class:list={['case-study', { 'case-study--standalone': standalone }]} id={record.id} aria-labelledby={`${record.id}-title`}>
  <header class="case-header">
    <p class="case-locator">{record.openingContext}</p>
    {standalone ? <h1 id={`${record.id}-title`}>{document.title}</h1> : <h3 id={`${record.id}-title`}>{document.title}</h3>}
    <p class="case-argument"><span>{record.argumentRole.authorship}</span>{record.argumentRole.text}</p>
    <dl class="case-meta">
      <div><dt>Place</dt><dd>{record.location.display}</dd></div>
      <div><dt>Period</dt><dd>{record.displayPeriod}</dd></div>
      <div><dt>Classification</dt><dd>{record.classification.display}</dd></div>
      <div class="case-meta__estimate">
        <dt>Estimated deaths</dt>
        <dd>{record.deathEstimate.display}<span class="case-meta__uncertainty">{record.deathEstimate.uncertainty}</span></dd>
      </div>
    </dl>
    <p class="source-status">Case metadata and quantitative estimates remain marked <strong>requires source trace</strong>; presentation does not certify legacy claims.</p>
    {record.duration.note && (
      <p class="source-status case-duration-note"><strong>How this case is measured.</strong> {record.duration.note}</p>
    )}
  </header>

  <div class="case-body">
    {record.sections.map((section) => {
      const content = document.sections[section.key];
      if (!content) throw new Error(`Case ${record.id} declares section ${section.key}, which the Markdown does not carry.`);
      const headingId = `${record.id}-section-${section.key.toLowerCase()}`;
      return (
        <section class:list={['case-section', sectionClass[section.kind]]} aria-labelledby={headingId}>
          <h2 id={headingId}>{content.title}</h2>
          <p class="section-authorship">{section.authorship}</p>
          {section.note && <p class="section-note">{section.note}</p>}
          {section.kind === 'chronology'
            ? <Chronology chronology={record.chronology} />
            : <div class="prose" set:html={content.html} />}
          {section.kind === 'narrative' && record.evidence.map((evidence) => (
            <aside class="evidence-provenance" aria-label={`Provenance of the ${evidenceKindLabel(evidence.kind).toLowerCase()} quoted in this section`}>
              <p class="evidence-provenance__kind">{evidenceKindLabel(evidence.kind)}</p>
              <p><strong>{evidence.speaker}</strong> — {evidence.context}</p>
              <p>Trace status: {sourceStatusLabel(evidence.sourceStatus)}; quotation status: {quotationStatusLabel(evidence.quotationStatus)}.</p>
            </aside>
          ))}
        </section>
      );
    })}
  </div>

  <nav class="case-sequence" aria-label="Case study sequence">
    {previous ? <a href={caseHref(previous)}><span>Previous</span> <strong>{previous.navTitle}</strong></a> : <a href={route('/cases')}><span>Back to</span> <strong>the case index</strong></a>}
    {next ? <a href={caseHref(next)}><span>Next</span> <strong>{next.navTitle}</strong></a> : <a href={linkMode === 'fragments' ? '#part-iii' : route('/comparison')}><span>Next</span> <strong>Cross-case analysis</strong></a>}
  </nav>
</article>
