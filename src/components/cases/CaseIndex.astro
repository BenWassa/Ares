---
import type { CaseRecord } from '../../lib/content/schemas';
import { caseSpanInWords, caseYear } from '../../lib/content/case-display';
import { caseRoute } from '../../lib/routes';
interface Props { cases: CaseRecord[] }
const { cases } = Astro.props;
---
<ol class="case-index" aria-label="Historical cases in chronological order">
  {cases.map((record) => (
    <li>
      <a href={caseRoute(record.id)}>
        <span class="case-index__date">{caseYear(record)}</span>
        <span class="case-index__title">{record.navTitle.replace(/\s*\([^)]*\)$/, '')}</span>
        <span class="case-index__place">{record.location.display} · {caseSpanInWords(record)}</span>
        <span class="case-index__classification">{record.classification.display}</span>
      </a>
    </li>
  ))}
</ol>
<p class="source-status case-index__status">Dates, spans, historical classifications, quantitative estimates and testimony chains retain their existing <strong>requires source trace</strong> status until source-level review is complete.</p>
