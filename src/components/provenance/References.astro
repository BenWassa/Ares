---
import type { ReferenceRecord } from '../../lib/content/schemas';
interface Props { references: ReferenceRecord[] }
const { references } = Astro.props;
---
<section id="references" class="references-section" aria-label="Source registry">
  <p class="references-note">Stable source identifiers are part of the publication contract. Case-level legacy claims that still say <em>requires source trace</em> have deliberately not been upgraded to verified status by this interface overhaul.</p>
  <ol class="references-list">
    {references.map((reference) => (
      <li id={`ref-${reference.id}`} tabindex="-1">
        {reference.authors.join(', ')} ({reference.year}). <cite>{reference.title}</cite>. {reference.container}{reference.volume ? ` ${reference.volume}` : ''}{reference.issue ? `(${reference.issue})` : ''}{reference.pages ? `, ${reference.pages}` : ''}. {reference.doi && <span>doi:{reference.doi}</span>}
      </li>
    ))}
  </ol>
</section>
