---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import HistoricalField from '../components/cases/HistoricalField.astro';
import ChronologyRail from '../components/cases/ChronologyRail.astro';
import ResumeHome from '../components/reading/ResumeHome.astro';
import { loadStructuredContent } from '../lib/content/loaders';
import { loadMobileReadingPrototype } from '../lib/content/reading-prototype';
import { loadHierarchy } from '../lib/content/hierarchy';
import { caseRoute, publicationRoutes, route } from '../lib/routes';

const { cases: caseFile } = await loadStructuredContent();
const hierarchy = loadHierarchy(caseFile.cases, loadMobileReadingPrototype(caseFile.cases));
const screenRoutes = [...hierarchy.byId.values()].filter((unit) => unit.screen).map((unit) => route(unit.route));
const cases = [...caseFile.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));

/** Durable aliases retained from the earlier one-page and chooser structures. */
const legacyLinks = [
  { id: 'part-i', href: route('/framework') },
  { id: 'scope-purpose', href: `${route('/framework')}#scope-purpose` },
  { id: 'definitions-typology', href: route('/framework/definitions-typology') },
  { id: 'theoretical-lenses', href: route('/framework/theoretical-lenses') },
  { id: 'part-ii', href: route('/cases') },
  ...cases.map((record) => ({ id: record.id, href: caseRoute(record.id) })),
  { id: 'part-iii', href: route('/comparison') },
  { id: 'part-iv', href: route('/process') },
  { id: 'part-v', href: route('/implications') },
  { id: 'part-vi', href: route('/reflection') },
  { id: 'glossary', href: route('/glossary') },
  { id: 'references', href: route('/references') },
];
const legacyMap = Object.fromEntries(legacyLinks.map((item) => [item.id, item.href]));
---
<PublicationLayout
  title="Project Ares · Eight historical cases of mass killing, 1915–1995"
  description="Project Ares examines eight historical cases of mass killing and asks which human and institutional conditions recur across them."
  currentLabel="Home"
  currentPath="/"
  surface="home"
>
  <div class="home" aria-labelledby="ares-title">
    <header id="front-matter" class="home-cover">
      <div class="home-cover__inner">
        <p class="home-cover__credit">Project Ares · digital publication</p>
        <div class="home-cover__title">
          <h1 id="ares-title" class="home-wordmark">Project Ares</h1>
          <p class="home-cover__descriptor">Eight historical cases of mass killing · 1915–1995</p>
          <p class="home-cover__deck">They unfold across different societies and regimes, from single-day massacres to years-long campaigns. Project Ares asks what human and institutional conditions recur across them.</p>
          <ChronologyRail cases={cases} variant="hero" />
          <div class="home-cover__actions" aria-label="Start reading">
            <a class="home-primary" href="#historical-field">See the eight cases</a>
          </div>
        </div>
      </div>
    </header>

    <div class="home-body">
      <div class="home-resume"><ResumeHome knownRoutes={screenRoutes} variant="compact" /></div>

      <HistoricalField cases={cases} />

      <section id="proposition" class="home-section home-question" aria-labelledby="proposition-title">
        <span id="comparison-question" class="home-anchor-alias" aria-hidden="true"></span>
        <p class="home-section__label">The question</p>
        <h2 id="proposition-title">What makes organized mass killing possible?</h2>
        <p class="home-question__body">These cases are not interchangeable. Project Ares asks which human and institutional conditions recur across them—and how those conditions can help make organized mass killing possible.</p>
      </section>

      <section id="recurring-conditions" class="home-section home-framework" aria-labelledby="recurring-conditions-title">
        <p class="home-section__label">What appears to recur</p>
        <h2 id="recurring-conditions-title">Recurring conditions, not a fixed sequence</h2>
        <p class="home-framework__body">Ares follows four interacting kinds of condition: political and social conditions; construction of a threatening out-group; authorization and organization; and the situational dynamics that can move people into violence. They are not a fixed sequence.</p>
        <p class="home-framework__source">Ares synthesis of Dutton, Boyanowsky &amp; Bond (2005).</p>
        <a class="home-inline-action" href={route('/framework')}>Read the framework</a>
      </section>

      <section id="publication-apparatus" class="home-section home-apparatus" aria-label="Publication contents, sources and method">
        <p class="home-apparatus__intro">For the complete publication, source registry, uncertainty and method:</p>
        <details class="home-apparatus__contents">
          <summary>Contents</summary>
          <nav aria-label="Complete publication contents">
            <ul>
              {publicationRoutes.map((item) => (
                <li><a href={route(item.path)}><span>{item.label}</span>{item.title}</a></li>
              ))}
            </ul>
          </nav>
        </details>
        <nav class="home-apparatus__links" aria-label="Publication apparatus">
          <a href={route('/references')}>Sources &amp; provenance</a>
          <a href={route('/framework')}>About &amp; method</a>
        </nav>
      </section>
    </div>

    <div class="legacy-anchor-aliases" aria-hidden="true">
      {legacyLinks.map((item) => <span id={item.id}>Moved</span>)}
    </div>
  </div>

  <!-- Home is the one route-specific composition in Ares. As on the approved
       2.3 Home, its CSS stays inline so it does not inflate every publication
       route's shared stylesheet; the total-build budget still counts the bytes. -->
  <style is:inline>
    body.ares-surface-home { min-height: 100vh; background: var(--paper); color: var(--ink); }
    .home { overflow: clip; }
    .home-cover { position: relative; display: grid; min-height: min(92svh, 54rem); align-items: end; padding: var(--space-7) 0 var(--space-8); color: var(--night-ink); background: var(--void); border-bottom: 1px solid var(--rule-strong); }
    .home-cover::after { position: absolute; bottom: -1px; left: max(var(--gutter), calc((100% - var(--page-max)) / 2 + var(--gutter))); width: 4.5rem; height: 2px; background: var(--accent); content: ''; }
    .home-cover__inner { display: grid; grid-template-rows: auto 1fr; gap: var(--space-7); width: min(100%, var(--page-max)); min-height: inherit; margin-inline: auto; padding-inline: var(--gutter); }
    .home-cover__credit { margin: 0; padding-bottom: var(--space-4); color: var(--night-muted); border-bottom: 1px solid var(--night-rule); font: var(--weight-medium) var(--step-1)/1.4 var(--font-ui); letter-spacing: var(--track-label); text-transform: uppercase; }
    .home-cover__title { align-self: end; }
    .home-wordmark { max-width: 100%; margin: 0; color: var(--night-ink); font: var(--weight-bold) clamp(var(--step-6), 14vw, var(--step-8))/.9 var(--font-text); letter-spacing: var(--track-display); overflow-wrap: normal; }
    .home-cover__descriptor { max-width: 38ch; margin: var(--space-5) 0 0; padding-top: var(--space-4); color: var(--accent-lift); border-top: 1px solid var(--night-rule); font: var(--weight-medium) var(--step-1)/1.5 var(--font-ui); letter-spacing: var(--track-label); text-transform: uppercase; }
    .home-cover__deck { max-width: 46ch; margin: var(--space-4) 0 0; color: var(--night-muted); font: var(--weight-text) var(--step-4)/1.5 var(--font-text); }
    .home-cover__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin-top: var(--space-5); }
    .home-primary, .home-inline-action, .historical-field__method { display: inline-flex; min-height: 44px; align-items: center; font-family: var(--font-ui); }
    .home-primary { min-height: 52px; padding-inline: var(--space-5); color: var(--night-ink); background: var(--accent-deep); border: 1px solid var(--accent); font-size: var(--step-2); font-weight: var(--weight-medium); text-decoration: none; }
    .home-primary:hover { background: var(--accent); }

    .chronology-rail { width: 100%; max-width: 48rem; }
    .chronology-rail__plot { position: relative; height: 2.75rem; margin-inline: 1px; }
    .chronology-rail__line { position: absolute; inset: 50% 0 auto; height: 1px; background: var(--rule-strong); transform: translateY(-50%); }
    .chronology-rail__mark { position: absolute; left: calc(var(--chronology-position) * 100%); top: 50%; width: 2px; height: 1.35rem; background: var(--accent-lift); transform: translate(-50%, -50%); }
    .chronology-rail__years { display: flex; justify-content: space-between; color: var(--ink-muted); font: var(--weight-medium) var(--step-1)/1.35 var(--font-ui); font-variant-numeric: tabular-nums lining-nums; letter-spacing: var(--track-label); }
    .home-cover .chronology-rail { margin-top: var(--space-5); }
    .home-cover .chronology-rail__line { background: var(--night-rule); }
    .home-cover .chronology-rail__years { color: var(--night-muted); }

    .home-body { width: min(100%, var(--page-max)); margin-inline: auto; padding-inline: var(--gutter); }
    .home-resume { min-height: 0; margin-top: var(--space-4); }
    .home-resume:has(.resume-card[hidden]) { margin-top: 0; }
    .home-resume .resume-card--compact { min-height: 52px; margin: 0; padding: 0; border: 0; border-bottom: 1px solid var(--rule); background: transparent; }
    .home-resume .resume-card--compact .resume-card__actions { width: 100%; justify-content: space-between; }
    .home-resume .resume-card--compact a, .home-resume .resume-card--compact button { min-height: 44px; border: 0; padding-inline: 0; }
    .home-resume .resume-card--compact button { min-width: 44px; justify-content: center; font-size: var(--step-3); }

    .home-section { max-width: var(--wide-measure); margin-inline: auto; padding-block: clamp(5rem, 12vw, 8rem); border-bottom: 1px solid var(--rule-strong); scroll-margin-top: var(--space-5); }
    .home-section__label { margin: 0 0 var(--space-3); color: var(--accent-lift); font: var(--weight-medium) var(--step-1)/1.35 var(--font-ui); letter-spacing: var(--track-label); text-transform: uppercase; }
    .home-section h2 { max-width: 18ch; margin: 0; font-size: var(--step-6); line-height: 1.02; }

    .historical-field { max-width: 52rem; }
    .historical-field__heading { display: grid; gap: var(--space-4); }
    .historical-field__heading p { max-width: 52ch; margin: 0; color: var(--ink-soft); font: var(--weight-text) var(--step-2)/1.55 var(--font-ui); }
    .historical-field .chronology-rail { margin-top: var(--space-6); }
    .historical-field__legend { margin: var(--space-2) 0 var(--space-6); color: var(--ink-muted); font: var(--weight-text) var(--step-1)/1.45 var(--font-ui); }
    .historical-field__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--rule-strong); }
    .historical-field__item { margin: 0; }
    .historical-field__entry { display: grid; min-height: 92px; align-content: center; gap: var(--space-1); padding: var(--space-4) var(--space-3); color: var(--ink); border-bottom: 1px solid var(--rule); text-decoration: none; }
    .historical-field__entry:hover { background: var(--paper-raised); }
    .historical-field__case { font: var(--weight-medium) var(--step-4)/1.2 var(--font-text); }
    .historical-field__location, .historical-field__window { color: var(--ink-soft); font: var(--weight-text) var(--step-1)/1.5 var(--font-ui); }
    .historical-field__window { color: var(--ink-muted); }
    .historical-field__boundary { max-width: 56ch; margin: var(--space-5) 0 0; color: var(--ink-muted); font: var(--weight-text) var(--step-1)/1.55 var(--font-ui); }
    .historical-field__method { margin-top: var(--space-3); color: var(--accent-lift); font-size: var(--step-2); }

    .home-question, .home-framework { max-width: var(--measure); }
    .home-question__body, .home-framework__body { max-width: 46ch; margin: var(--space-5) 0 0; color: var(--ink-soft); font: var(--weight-text) var(--step-3)/1.6 var(--font-text); }
    .home-framework__source { max-width: 46ch; margin: var(--space-4) 0 0; color: var(--ink-muted); font: var(--weight-text) var(--step-1)/1.5 var(--font-ui); }
    .home-inline-action { margin-top: var(--space-4); color: var(--accent-lift); font-size: var(--step-2); font-weight: var(--weight-medium); }

    .home-apparatus { max-width: var(--wide-measure); padding-block: var(--space-7) var(--space-8); border-bottom: 0; }
    .home-apparatus__intro { max-width: 48ch; margin: 0 0 var(--space-4); color: var(--ink-muted); font: var(--weight-text) var(--step-1)/1.55 var(--font-ui); }
    .home-apparatus__contents { border-top: 1px solid var(--rule-strong); border-bottom: 1px solid var(--rule-strong); }
    .home-apparatus__contents > summary { display: flex; min-height: 52px; align-items: center; justify-content: space-between; color: var(--ink-soft); cursor: pointer; font: var(--weight-medium) var(--step-2)/1.35 var(--font-ui); list-style: none; }
    .home-apparatus__contents > summary::-webkit-details-marker { display: none; }
    .home-apparatus__contents > summary::after { content: '+'; color: var(--accent-lift); font-size: var(--step-3); }
    .home-apparatus__contents[open] > summary::after { content: '−'; }
    .home-apparatus__contents nav { padding-bottom: var(--space-4); }
    .home-apparatus__contents ul { display: grid; margin: 0; padding: 0; list-style: none; }
    .home-apparatus__contents li + li { border-top: 1px solid var(--rule); }
    .home-apparatus__contents a { display: grid; grid-template-columns: 5rem minmax(0, 1fr); min-height: 44px; align-items: center; gap: var(--space-3); color: var(--ink-soft); font: var(--weight-text) var(--step-1)/1.4 var(--font-ui); text-decoration: none; }
    .home-apparatus__contents a:hover { color: var(--ink); }
    .home-apparatus__contents a span { color: var(--accent-lift); }
    .home-apparatus__links { display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-6); margin-top: var(--space-4); }
    .home-apparatus__links a { display: inline-flex; min-height: 44px; align-items: center; color: var(--ink-muted); font: var(--weight-text) var(--step-1)/1.4 var(--font-ui); }
    .home-anchor-alias { display: block; width: 0; height: 0; overflow: hidden; }
    .legacy-anchor-aliases { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }

    @media (max-width: 44rem) {
      .home-cover { min-height: min(90svh, 46rem); padding-top: var(--space-6); }
      .home-cover__inner { gap: var(--space-6); }
      .home-cover__actions { align-items: stretch; }
      .home-primary { justify-content: center; width: 100%; }
      .home-section { padding-block: clamp(4.25rem, 17vw, 6.25rem); }
      .home-section h2 { font-size: var(--step-5); }
      .historical-field__entry { padding-inline: 0; }
      .home-apparatus__links { display: grid; gap: 0; }
    }
    @media (max-width: 22.5rem) {
      .home-cover__deck { font-size: var(--step-3); }
      .chronology-rail__plot { height: 2.4rem; }
    }
    @media (max-height: 30rem) and (min-width: 44.01rem) {
      .home-cover { min-height: auto; padding-block: var(--space-5); }
      .home-cover__inner { gap: var(--space-4); }
      .home-wordmark { font-size: var(--step-7); }
      .home-cover__descriptor { margin-top: var(--space-3); padding-top: var(--space-3); }
      .home-cover__deck { margin-top: var(--space-3); font-size: var(--step-3); }
      .home-cover .chronology-rail, .home-cover__actions { margin-top: var(--space-3); }
      .chronology-rail__plot { height: 2rem; }
    }
    @media (prefers-reduced-motion: reduce) { .home * { scroll-behavior: auto !important; } }
  </style>

  <script is:inline define:vars={{ legacyMap }}>
    (() => {
      const destination = legacyMap[decodeURIComponent(window.location.hash.slice(1))];
      if (destination) window.location.replace(destination);
    })();
  </script>
</PublicationLayout>
