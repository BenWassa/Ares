---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import ResumeHome from '../components/reading/ResumeHome.astro';
import { loadStructuredContent } from '../lib/content/loaders';
import { loadMobileReadingPrototype } from '../lib/content/reading-prototype';
import { loadHierarchy } from '../lib/content/hierarchy';
import { caseRoute, route } from '../lib/routes';

const { cases: caseFile } = await loadStructuredContent();
const hierarchy = loadHierarchy(caseFile.cases, loadMobileReadingPrototype(caseFile.cases));
const screenRoutes = [...hierarchy.byId.values()].filter((unit) => unit.screen).map((unit) => route(unit.route));
const cases = [...caseFile.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));
const legacyLinks = [
  { id: 'part-i', href: route('/framework') }, { id: 'scope-purpose', href: route('/framework/scope-purpose') },
  { id: 'definitions-typology', href: route('/framework/definitions-typology') }, { id: 'theoretical-lenses', href: route('/framework/theoretical-lenses') },
  { id: 'part-ii', href: route('/cases') }, ...cases.map((record) => ({ id: record.id, href: caseRoute(record.id) })),
  { id: 'part-iii', href: route('/comparison') }, { id: 'part-iv', href: route('/process') },
  { id: 'part-v', href: route('/implications') }, { id: 'part-vi', href: route('/reflection') },
  { id: 'glossary', href: route('/glossary') }, { id: 'references', href: route('/references') },
];
const legacyMap = Object.fromEntries(legacyLinks.map((item) => [item.id, item.href]));
---
<PublicationLayout title="The Human Story of Extreme Mass Homicide · Ares" description="A source-conscious digital publication interpreting Dutton, Boyanowsky & Bond (2005) through eight historical case studies." currentLabel="Home" currentPath="/">
  <main class="home-choice page-frame" aria-labelledby="ares-title">
    <header id="front-matter" class="home-choice__intro"><p class="section-authorship">A source-conscious digital publication</p><h1 id="ares-title">Ares</h1><p>Explore how extreme mass killing develops across eight historically distinct cases, with evidence, uncertainty and scholarly depth kept visible.</p></header>
    <ResumeHome knownRoutes={screenRoutes} />
    <nav class="goal-paths" aria-label="Choose how to enter Ares"><div class="goal-paths__grid">
      <a href={route('/guided')}><small>Guided reading</small><strong>Follow the essential argument</strong><span>Move through the major parts in a clear reading path.</span></a>
      <a href={route('/cases')}><small>Explore cases</small><strong>Choose a historical case</strong><span>Enter directly through one of the eight canonical cases.</span></a>
      <a href={route('/full-publication')}><small>Full publication</small><strong>Browse the complete hierarchy</strong><span>Find every chapter, research utility and source layer.</span></a>
    </div></nav>
    <a class="home-choice__about" href={route('/full-publication#about-ares')}>About / How Ares works</a>
    <div class="legacy-anchor-aliases" aria-hidden="true">{legacyLinks.map((item) => <a id={item.id} href={item.href}>Moved</a>)}</div>
  </main>
  <script is:inline define:vars={{ legacyMap }}>(() => { const destination = legacyMap[decodeURIComponent(window.location.hash.slice(1))]; if (destination) window.location.replace(destination); })();</script>
</PublicationLayout>
