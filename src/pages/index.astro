---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import CaseIndex from '../components/cases/CaseIndex.astro';
import { loadSectionHtml, loadStructuredContent } from '../lib/content/loaders';
import { caseRoute, publicationRoutes, route } from '../lib/routes';

const { cases: caseFile, glossary } = await loadStructuredContent();
const cases = [...caseFile.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));
const glossaryPrefix = `${route('/glossary')}#glossary-`;
const frontMatter = await loadSectionHtml('front-matter', glossary, { glossaryHrefPrefix: glossaryPrefix });

const headings = [...frontMatter.matchAll(/<h2>(.*?)<\/h2>/g)];
const openingEnd = headings[0]?.index ?? frontMatter.length;
const openingHtml = frontMatter.slice(0, openingEnd);
const sections = new Map<string, string>();
headings.forEach((match, index) => {
  const start = (match.index ?? 0) + match[0].length;
  const end = headings[index + 1]?.index ?? frontMatter.length;
  sections.set(match[1] ?? '', frontMatter.slice(start, end));
});

const routeDescriptions: Record<string, string> = {
  '/framework': 'Definitions, scope and the theoretical lenses that anchor the reading.',
  '/cases': 'Eight historically distinct cases, each with testimony, chronology and analysis.',
  '/comparison': 'Cross-case patterns without reducing cases to a score or universal sequence.',
  '/process': 'Four interacting Ares synthesis domains, source-mapped and explicitly non-sequential.',
  '/implications': 'Prevention, warning and research boundaries with provenance kept visible.',
  '/reflection': 'Critical limits, uncertainty and what the publication can responsibly claim.',
  '/glossary': 'Durable definitions for direct study and return.',
  '/references': 'The stable source registry and provenance boundary.',
};

const legacyLinks = [
  { id: 'part-i', href: route('/framework'), label: 'Part I — Framework' },
  { id: 'scope-purpose', href: `${route('/framework')}#scope-purpose`, label: 'Scope & Purpose' },
  { id: 'definitions-typology', href: `${route('/framework')}#definitions-typology`, label: 'Definitions & Typology' },
  { id: 'theoretical-lenses', href: `${route('/framework')}#theoretical-lenses`, label: 'Theoretical Lenses' },
  { id: 'part-ii', href: route('/cases'), label: 'Part II — Historical cases' },
  ...cases.map((record) => ({ id: record.id, href: caseRoute(record.id), label: record.navTitle })),
  { id: 'part-iii', href: route('/comparison'), label: 'Part III — Comparison' },
  { id: 'part-iv', href: route('/process'), label: 'Part IV — Process synthesis' },
  { id: 'part-v', href: route('/implications'), label: 'Part V — Implications' },
  { id: 'part-vi', href: route('/reflection'), label: 'Part VI — Critical reflection' },
  { id: 'glossary', href: route('/glossary'), label: 'Glossary' },
  { id: 'references', href: route('/references'), label: 'References' },
];
const legacyMap = Object.fromEntries(legacyLinks.map((item) => [item.id, item.href]));
---
<PublicationLayout title="The Human Story of Extreme Mass Homicide · Ares" description="A source-conscious digital publication interpreting Dutton, Boyanowsky & Bond (2005) through eight historical case studies." currentLabel="Opening" currentPath="/">
  <div class="home-page page-frame">
    <section id="front-matter" class="home-cover" aria-label="Publication opening">
      <div class="home-cover__opening prose" set:html={openingHtml}></div>
      <aside class="home-cover__index" aria-label="Publication edition">
        <p><strong>Ares 2.2</strong><span>Digital humanities publication</span></p>
        <p><strong>8 cases</strong><span>1915–1995</span></p>
        <p><strong>4 domains</strong><span>Non-sequential synthesis</span></p>
        <p><strong>4 figures</strong><span>Source-grounded, no ranking</span></p>
      </aside>
    </section>

    <nav class="chapter-directory" aria-label="Publication chapters">
      <h2>Read by chapter</h2>
      <ol>
        {publicationRoutes.map((item) => (
          <li><a href={route(item.path)}><span class="chapter-directory__label">{item.label}</span><strong>{item.title}</strong><span>{routeDescriptions[item.path]}</span></a></li>
        ))}
      </ol>
    </nav>

    <section class="home-context" aria-labelledby="home-context-title">
      <div><h2 id="home-context-title">What this publication argues</h2><div class="prose" set:html={sections.get('Executive summary') ?? ''}></div></div>
      <aside class="content-note"><h2>A note before you begin</h2><div class="prose" set:html={sections.get('A note before you begin') ?? ''}></div></aside>
    </section>

    <details class="orientation-note">
      <summary>How to use Ares</summary>
      <div class="prose" set:html={sections.get('How to use Ares') ?? ''}></div>
    </details>

    <section class="home-cases" aria-labelledby="home-cases-title">
      <header><h2 id="home-cases-title">The case archive</h2><p>The cases are the evidentiary centre of Ares. Enter chronologically or choose a specific case.</p></header>
      <CaseIndex cases={cases} />
    </section>

    <section class="legacy-bridge" aria-labelledby="legacy-bridge-title">
      <h2 id="legacy-bridge-title">Legacy deep links</h2>
      <p>Earlier Ares 2.0 fragment URLs now resolve to dedicated publication pages.</p>
      <ul>{legacyLinks.map((item) => <li id={item.id}><a href={item.href}>{item.label}</a></li>)}</ul>
    </section>
  </div>
  <script is:inline define:vars={{ legacyMap }}>
    (() => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      const destination = legacyMap[id];
      if (destination) window.location.replace(destination);
    })();
  </script>
</PublicationLayout>
