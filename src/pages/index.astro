---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import ResumeHome from '../components/reading/ResumeHome.astro';
import { loadStructuredContent } from '../lib/content/loaders';
import { loadMobileReadingPrototype } from '../lib/content/reading-prototype';
import { loadHierarchy } from '../lib/content/hierarchy';
import { caseRoute, route } from '../lib/routes';

const { cases: caseFile } = await loadStructuredContent();
const hierarchy = loadHierarchy(caseFile.cases, loadMobileReadingPrototype(caseFile.cases));
const screenRoutes = [...hierarchy.byId.values()].filter((unit) => unit.screen).map((unit) => route(unit.route));
const cases = [...caseFile.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));
const legacyLinks = [
  { id: 'part-i', href: route('/framework') }, { id: 'scope-purpose', href: route('/framework/scope-purpose') },
  { id: 'definitions-typology', href: route('/framework/definitions-typology') }, { id: 'theoretical-lenses', href: route('/framework/theoretical-lenses') },
  { id: 'part-ii', href: route('/cases') }, ...cases.map((record) => ({ id: record.id, href: caseRoute(record.id) })),
  { id: 'part-iii', href: route('/comparison') }, { id: 'part-iv', href: route('/process') },
  { id: 'part-v', href: route('/implications') }, { id: 'part-vi', href: route('/reflection') },
  { id: 'glossary', href: route('/glossary') }, { id: 'references', href: route('/references') },
];
const legacyMap = Object.fromEntries(legacyLinks.map((item) => [item.id, item.href]));
---
<PublicationLayout
  title="The Human Story of Extreme Mass Homicide · Ares"
  description="A source-conscious digital publication interpreting Dutton, Boyanowsky & Bond (2005) through eight historical case studies."
  currentLabel="Home"
  currentPath="/"
  surface="home"
>
  <div class="home-entry page-frame" aria-labelledby="ares-title">
    <header id="front-matter" class="home-entry__intro">
      <h1 id="ares-title">Ares</h1>
      <p>Explore how extreme mass killing develops, with evidence and scholarly depth kept visible.</p>
    </header>

    <div class="home-entry__resume">
      <ResumeHome knownRoutes={screenRoutes} variant="compact" />
    </div>

    <nav class="home-entry__choices" aria-label="Choose how to enter Ares">
      <a href={route('/guided')} class="home-choice-row">
        <strong>Guided reading</strong>
        <span>Essential path →</span>
      </a>
      <a href={route('/cases')} class="home-choice-row">
        <strong>Explore cases</strong>
        <span>Eight cases →</span>
      </a>
      <a href={route('/full-publication')} class="home-choice-row">
        <strong>Full publication</strong>
        <span>Complete publication →</span>
      </a>
    </nav>

    <div class="home-entry__footer">
      <a href={route('/full-publication#about-ares')}>About / How Ares works</a>
    </div>

    <div class="legacy-anchor-aliases" aria-hidden="true">
      {legacyLinks.map((item) => <span id={item.id}>Moved</span>)}
    </div>
  </div>

  <style>
    :global(body.ares-surface-home) {
      min-height: 100vh;
      background: var(--paper);
      color: var(--ink);
    }

    :global(body.ares-surface-home main) {
      display: grid;
      min-height: 100vh;
      min-height: 100svh;
      align-items: center;
    }

    .home-entry {
      width: 100%;
      max-width: var(--measure);
      margin: 0 auto;
      padding: var(--space-6) var(--gutter);
    }

    .home-entry__intro {
      margin-bottom: var(--space-6);
    }

    .home-entry__intro h1 {
      margin: 0 0 var(--space-3);
      font: var(--weight-bold) var(--step-5)/1 var(--font-ui);
      letter-spacing: .02em;
      text-transform: uppercase;
    }

    .home-entry__intro p {
      max-width: 32rem;
      margin: 0;
      color: var(--ink-soft);
      font: var(--weight-text) var(--step-1)/1.5 var(--font-ui);
    }

    .home-entry__resume {
      margin-bottom: var(--space-5);
    }

    .home-entry__choices {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    .home-choice-row {
      display: flex;
      min-height: 4rem;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-4);
      border: 1px solid var(--rule-strong);
      background: var(--paper-raised);
      color: var(--ink);
      text-decoration: none;
      transition: background-color var(--motion-state) var(--ease-out), border-color var(--motion-state) var(--ease-out);
    }

    .home-choice-row:hover {
      border-color: var(--accent);
      background: var(--paper-high);
    }

    .home-choice-row:active {
      background: var(--accent-wash);
    }

    .home-choice-row:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .home-choice-row strong {
      font: var(--weight-bold) var(--step-2)/1.2 var(--font-ui);
    }

    .home-choice-row span {
      color: var(--ink-soft);
      font: var(--weight-medium) var(--step-1)/1.2 var(--font-ui);
      white-space: nowrap;
    }

    .home-entry__footer a {
      display: inline-flex;
      min-height: 2.75rem;
      align-items: center;
      color: var(--ink-muted);
      font: var(--weight-medium) var(--step-1)/1.2 var(--font-ui);
      text-decoration: none;
    }

    .home-entry__footer a:hover {
      color: var(--ink);
      text-decoration: underline;
    }

    @media (max-width: 35rem) {
      .home-choice-row {
        align-items: flex-start;
        flex-direction: column;
        justify-content: center;
        gap: var(--space-1);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-choice-row { transition-duration: 0.00001ms !important; }
    }
  </style>

  <script is:inline define:vars={{ legacyMap }}>
    (() => {
      const destination = legacyMap[decodeURIComponent(window.location.hash.slice(1))];
      if (destination) window.location.replace(destination);
    })();
  </script>
</PublicationLayout>
