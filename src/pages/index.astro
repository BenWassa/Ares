---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import ResumeHome from '../components/reading/ResumeHome.astro';
import { loadStructuredContent } from '../lib/content/loaders';
import { loadMobileReadingPrototype } from '../lib/content/reading-prototype';
import { loadHierarchy } from '../lib/content/hierarchy';
import { caseRoute, publicationRoutes, route } from '../lib/routes';

/**
 * The cover, and the whole table of contents.
 *
 * 2.3 opened on three grey rows that led to two further rooms of rows: `/guided`
 * listed five parts and `/full-publication` listed eight, so a reader spent two
 * clicks choosing a chooser before meeting a sentence of the publication. Both
 * of those surfaces are folded in here. Home now carries the complete directory,
 * which makes every route in Ares exactly one click from the front door.
 */
const { cases: caseFile } = await loadStructuredContent();
const hierarchy = loadHierarchy(caseFile.cases, loadMobileReadingPrototype(caseFile.cases));
const screenRoutes = [...hierarchy.byId.values()].filter((unit) => unit.screen).map((unit) => route(unit.route));
const cases = [...caseFile.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));

const descriptions: Record<string, string> = {
  '/framework': 'Scope, the comparison vocabulary, and the theoretical lenses.',
  '/cases': 'Eight historical chapters under one editorial grammar.',
  '/comparison': 'One controlled question at a time, and the complete matrix.',
  '/process': 'Four interacting domains. Non-sequential, and labelled as synthesis.',
  '/implications': 'Prevention, warning, and the boundaries of the argument.',
  '/reflection': 'What the argument cannot carry, stated by the publication itself.',
  '/glossary': 'Durable definitions, linked from every cued term.',
  '/references': 'The source registry and each claim’s trace status.',
};

/**
 * Fragment IDs are durable (AGENTS.md). Every legacy anchor still resolves, and
 * the two retired chooser routes keep their addresses here rather than 404ing.
 */
const legacyLinks = [
  { id: 'part-i', href: route('/framework') },
  { id: 'scope-purpose', href: `${route('/framework')}#scope-purpose` },
  { id: 'definitions-typology', href: route('/framework/definitions-typology') },
  { id: 'theoretical-lenses', href: route('/framework/theoretical-lenses') },
  { id: 'part-ii', href: route('/cases') },
  ...cases.map((record) => ({ id: record.id, href: caseRoute(record.id) })),
  { id: 'part-iii', href: route('/comparison') },
  { id: 'part-iv', href: route('/process') },
  { id: 'part-v', href: route('/implications') },
  { id: 'part-vi', href: route('/reflection') },
  { id: 'glossary', href: route('/glossary') },
  { id: 'references', href: route('/references') },
];
const legacyMap = Object.fromEntries(legacyLinks.map((item) => [item.id, item.href]));
---
<PublicationLayout
  title="Ares · The Human Story of Extreme Mass Homicide"
  description="A source-conscious digital publication interpreting Dutton, Boyanowsky & Bond (2005) through eight historical case studies."
  currentLabel="Home"
  currentPath="/"
  surface="home"
>
  <div class="home" aria-labelledby="ares-title">
    <header id="front-matter" class="home-cover">
      <div class="home-cover__inner">
        <p class="home-cover__credit">
          <span>Project Ares &middot; digital publication</span>
          <span>After Dutton, Boyanowsky &amp; Bond (2005),<br />“Extreme Mass Homicide: From Military
          Massacre to Genocide”</span>
        </p>

        <div class="home-cover__title">
          <h1 id="ares-title" class="home-wordmark">Ares</h1>
          <p class="home-cover__subject">The human story of extreme mass homicide</p>
          <p class="home-cover__deck">
            Eight historical cases, held against one another with provenance, uncertainty and
            testimony kept in view rather than cleaned away.
          </p>
          <div class="home-cover__actions">
            <a class="home-begin" href={route('/framework')}>Begin &mdash; Part&nbsp;I, Framework</a>
            <a class="home-secondary" href={route('/cases')}>Go straight to the eight cases</a>
          </div>
        </div>
      </div>
    </header>

    <div class="home-body page-frame">
      <div class="home-resume"><ResumeHome knownRoutes={screenRoutes} variant="compact" /></div>

      <nav class="chapter-directory home-contents" aria-labelledby="contents-title">
        <p class="reading-unit__index">Contents</p>
        <h2 id="contents-title">The complete publication</h2>
        <ol>
          {publicationRoutes.map((item) => (
            <li>
              <a href={route(item.path)}>
                <span class="chapter-directory__label">{item.label}</span>
                <strong>{item.title}</strong>
                <span>{descriptions[item.path]}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <section id="about-ares" class="home-about" aria-labelledby="about-title">
        <p class="reading-unit__index">About</p>
        <h2 id="about-title">How Ares works</h2>
        <div class="prose">
          <p>
            Ares is one canonical publication presented at different depths. Every part opens with
            what it is for and what it cannot settle; scholarly depth is offered on the same screen
            rather than behind another door.
          </p>
          <p>
            Part&nbsp;IV is an explicitly labelled <strong>Ares synthesis</strong> of four interacting
            domains, source-mapped to Dutton et al. It is non-sequential. Cases are compared, never
            ranked: no view in this publication orders them by severity, gravity or death toll.
          </p>
          <p>
            Claims marked <strong>requires source trace</strong> are unresolved integrity debt and are
            labelled as such wherever they appear.
            <a href={route('/references')}>Sources and provenance</a> records the trace status of each one.
          </p>
        </div>
      </section>
    </div>

    <div class="legacy-anchor-aliases" aria-hidden="true">
      {legacyLinks.map((item) => <span id={item.id}>Moved</span>)}
    </div>
  </div>

  <style>
    :global(body.ares-surface-home) {
      min-height: 100vh;
      background: var(--paper);
      color: var(--ink);
    }

    /* ---- Cover ----------------------------------------------------------- */
    /* The publication's one full-bleed moment. It is a well cut into the ground,
       closed by the same oxide bar every chapter opening carries, so the cover and
       a chapter are recognisably the same publication. */
    .home-cover {
      position: relative;
      display: grid;
      align-items: end;
      min-height: min(88svh, 52rem);
      padding: var(--space-8) 0 var(--space-7);
      background: var(--void);
      border-bottom: 1px solid var(--rule-strong);
    }

    .home-cover::after {
      position: absolute;
      bottom: -1px;
      left: max(var(--gutter), calc((100% - var(--page-max)) / 2 + var(--gutter)));
      width: 4.5rem;
      height: 2px;
      background: var(--accent);
      content: '';
    }

    /* A title page: the credit sits at the head of the sheet, the wordmark at its
       foot. The empty band between them is the composition, not a gap. */
    .home-cover__inner {
      display: grid;
      grid-template-rows: auto 1fr;
      gap: var(--space-7);
      width: min(100%, var(--page-max));
      min-height: inherit;
      margin-inline: auto;
      padding-inline: var(--gutter);
    }

    .home-cover__credit {
      display: grid;
      gap: var(--space-3);
      justify-items: end;
      margin: 0;
      padding-bottom: var(--space-4);
      border-bottom: 1px solid var(--rule-strong);
      color: var(--ink-muted);
      font: var(--weight-medium) var(--step-1)/1.6 var(--font-ui);
      letter-spacing: var(--track-label);
      text-align: right;
      text-transform: uppercase;
    }

    .home-cover__credit span:last-child { max-width: 40ch; color: var(--ink-muted); }

    .home-cover__title { align-self: end; }

    /* The wordmark is the only place in Ares that uses step 8. Newsreader at 700
       with the display tracking is the publication's signature; the 2.2 home set
       it in 24px sans, which named the site instead of opening it. */
    .home-wordmark {
      margin: 0;
      color: var(--ink);
      font: var(--weight-bold) var(--step-8)/.82 var(--font-text);
      letter-spacing: var(--track-display);
      text-transform: uppercase;
    }

    .home-cover__subject {
      max-width: 30ch;
      margin: var(--space-5) 0 0;
      padding-top: var(--space-4);
      border-top: 1px solid var(--rule-strong);
      color: var(--accent-lift);
      font: var(--weight-medium) var(--step-1)/1.5 var(--font-ui);
      letter-spacing: var(--track-label);
      text-transform: uppercase;
    }

    .home-cover__deck {
      max-width: 42ch;
      margin: var(--space-4) 0 0;
      color: var(--ink-soft);
      font: var(--weight-text) var(--step-4)/1.5 var(--font-text);
    }

    .home-cover__actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-5);
      margin-top: var(--space-6);
    }

    /* One primary action on the cover, and it is a filled oxide block: everything
       else in the system is a rule or a keyline, so a fill reads as the way in. */
    .home-begin {
      display: inline-flex;
      min-height: 3.25rem;
      align-items: center;
      padding: 0 var(--space-5);
      color: var(--ink);
      background: var(--accent-deep);
      border: 1px solid var(--accent);
      font: var(--weight-medium) var(--step-2)/1.2 var(--font-ui);
      text-decoration: none;
    }

    .home-begin:hover { background: var(--accent); }
    .home-begin:active { background: var(--accent-deep); }

    .home-secondary {
      display: inline-flex;
      min-height: 3.25rem;
      align-items: center;
      color: var(--ink-soft);
      font: var(--weight-medium) var(--step-2)/1.2 var(--font-ui);
      text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    }

    .home-secondary:hover { color: var(--ink); }

    /* The fourth state. An inline link cannot take the 1px press (transform does
       not apply to inline boxes), so it thickens its underline the way every
       other inline control in the system does. */
    .home-secondary:active {
      color: var(--accent-lift);
      text-decoration-thickness: .14em;
    }

    /* ---- Body ------------------------------------------------------------ */
    .home-body {
      width: min(100%, var(--page-max));
      margin-inline: auto;
      padding-top: var(--space-7);
    }

    .home-resume { margin-bottom: var(--space-6); }
    .home-contents { margin-bottom: var(--space-8); }
    .home-contents > h2 { margin: var(--space-2) 0 var(--space-5); }
    .home-about { max-width: var(--measure); padding-bottom: var(--space-8); }
    .home-about > h2 { margin: var(--space-2) 0 var(--space-4); }

    @media (max-width: 44rem) {
      .home-cover { min-height: min(84svh, 42rem); }
      .home-cover__inner { gap: var(--space-6); }
      .home-cover__credit { justify-items: start; text-align: left; }
      .home-cover__credit span:last-child { display: none; }
      .home-cover__actions { flex-direction: column; align-items: stretch; gap: var(--space-2); }
      .home-begin, .home-secondary { justify-content: center; }
    }
  </style>

  <script is:inline define:vars={{ legacyMap }}>
    (() => {
      const destination = legacyMap[decodeURIComponent(window.location.hash.slice(1))];
      if (destination) window.location.replace(destination);
    })();
  </script>
</PublicationLayout>
