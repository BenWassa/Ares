---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import PageIntro from '../components/publication/PageIntro.astro';
import ReadingLocation from '../components/reading/ReadingLocation.astro';
import UnitCaveats from '../components/reading/UnitCaveats.astro';
import UnitChildren from '../components/reading/UnitChildren.astro';
import UnitNavigation from '../components/reading/UnitNavigation.astro';
import { loadStructuredContent } from '../lib/content/loaders';
import { loadMobileReadingPrototype } from '../lib/content/reading-prototype';
import { loadHierarchy } from '../lib/content/hierarchy';
import { route } from '../lib/routes';

const { cases: caseFile } = await loadStructuredContent();
const cases = [...caseFile.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));
const prototype = loadMobileReadingPrototype(cases);
const hierarchy = loadHierarchy(cases, prototype);
const description = hierarchy.describe('comparison');

/**
 * The dimension view and the complete comparison were anchors on this route before
 * #51 made them screens. The anchors stay and forward, so #46 references, browser
 * history and any copied link keep resolving to the material they named.
 */
const stageAliases: Record<string, string> = {
  tempo: route('/comparison/tempo'),
  'full-comparison-depth': route('/comparison/scholarly-depth'),
  'full-matrix': route('/comparison/scholarly-depth'),
  'full-analysis': route('/comparison/scholarly-depth'),
};
---
<PublicationLayout title="Cross-case comparison · Ares" description="A comparison overview that hands one controlled dimension and the complete scholarly comparison to separate reading screens." currentLabel="Guided reading · Comparison" currentPath="/comparison">
  <article class="chapter-page page-frame" id="part-iii">
    <PageIntro title={description.unit.title} description="The overview states what survives comparison and hands the rest to two screens: one controlled dimension, or the complete scholarly comparison." />

    <ReadingLocation description={description} />

    <aside class="integrity-note reading-unit dimension-view__intro" role="note"><strong>Method note.</strong> {prototype.comparison.warning}</aside>

    <section id="comparison-findings" class="reading-unit" data-reading-section data-reading-label="High-level findings" aria-labelledby="comparison-findings-title">
      <p class="reading-unit__index">Essential · findings before any matrix</p>
      <h2 id="comparison-findings-title">Four findings before the matrix</h2>
      <ol class="comparison-findings">{prototype.comparison.findings.map((finding) => <li>{finding}</li>)}</ol>
    </section>

    <UnitChildren
      description={description}
      title="Two screens, two different jobs"
      intro="The dimension screen holds one variable stable across all eight cases. The complete comparison is research material: the duration figure, the full matrix and the comparative-analysis manuscript on one surface."
    />

    <UnitCaveats unit={description.unit} title="What comparison in Ares does not do" />

    <UnitNavigation description={description} />

    <div class="legacy-anchor-aliases" aria-hidden="true">
      {Object.keys(stageAliases).map((id) => <span id={id}>Moved to its own reading screen.</span>)}
    </div>
  </article>
  <script is:inline define:vars={{ stageAliases }}>
    (() => {
      const destination = stageAliases[decodeURIComponent(window.location.hash.slice(1))];
      if (destination) window.location.replace(destination);
    })();
  </script>
</PublicationLayout>
