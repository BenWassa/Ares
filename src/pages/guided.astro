---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import PageIntro from '../components/publication/PageIntro.astro';
import { route } from '../lib/routes';
const choices = [
  ['/framework', 'Framework', 'Establish the concepts and boundaries used by the publication.'],
  ['/cases/my-lai-massacre', 'Historical cases', 'Follow the representative case path through My Lai.'],
  ['/comparison', 'Cross-case findings', 'Compare cases one controlled question at a time.'],
  ['/process', 'Process', 'Read the four interacting, non-sequential synthesis domains.'],
  ['/implications', 'Implications / conclusion', 'Consider prevention, warning and the limits of the argument.'],
] as const;
---
<PublicationLayout title="Guided reading · Ares" description="Choose the next major group in Ares's essential argument." currentLabel="Guided reading" currentPath="/guided">
  <article class="parent-screen page-frame"><a class="case-index-link" href={route('/')}>Ares / Home</a><PageIntro title="Guided reading" description="Choose a major part of the argument; each destination then presents only its immediate reading choices." />
    <nav class="chapter-directory" aria-label="Guided reading groups"><ol>{choices.map(([path,title,description], index) => <li><a href={route(path)}><span class="chapter-directory__label">{index + 1} of {choices.length}</span><strong>{title}</strong><span>{description}</span></a></li>)}</ol></nav>
  </article>
</PublicationLayout>
