---
import PublicationLayout from '../layouts/PublicationLayout.astro';
import PageIntro from '../components/publication/PageIntro.astro';
import ReadingLocation from '../components/reading/ReadingLocation.astro';
import UnitChildren from '../components/reading/UnitChildren.astro';
import UnitNavigation from '../components/reading/UnitNavigation.astro';
import { loadStructuredContent } from '../lib/content/loaders';
import { loadMobileReadingPrototype } from '../lib/content/reading-prototype';
import { loadHierarchy } from '../lib/content/hierarchy';
import { route } from '../lib/routes';
const { cases: caseFile, glossary } = await loadStructuredContent();
const description = loadHierarchy(caseFile.cases, loadMobileReadingPrototype(caseFile.cases)).describe('framework');
const stageAliases = { 'definitions-typology': route('/framework/definitions-typology'), 'scope-purpose': route('/framework/scope-purpose'), 'theoretical-lenses': route('/framework/theoretical-lenses') };
---
<PublicationLayout title="Framework · Ares" description="Choose one of the framework's three immediate conceptual units." currentLabel="Guided reading · Framework" currentPath="/framework" glossary={glossary}>
  <article class="chapter-page page-frame"><PageIntro title={description.unit.title} description="These three units establish the scope, comparison vocabulary and theoretical lenses used by Ares." id="part-i" /><ReadingLocation description={description}/><UnitChildren description={description} title="Choose a framework unit" intro="Each unit has one conceptual job and its own durable reading screen."/><UnitNavigation description={description}/><div class="legacy-anchor-aliases" aria-hidden="true">{Object.keys(stageAliases).map((id) => <a id={id} href={stageAliases[id as keyof typeof stageAliases]}>Moved</a>)}</div></article>
  <script is:inline define:vars={{ stageAliases }}>(() => { const destination = stageAliases[decodeURIComponent(window.location.hash.slice(1))]; if (destination) window.location.replace(destination); })();</script>
</PublicationLayout>
