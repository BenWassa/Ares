---
import PublicationLayout from '../../../layouts/PublicationLayout.astro';
import ChronologySpine from '../../../components/figures/ChronologySpine.astro';
import ReadingLocation from '../../../components/reading/ReadingLocation.astro';
import UnitCaveats from '../../../components/reading/UnitCaveats.astro';
import UnitNavigation from '../../../components/reading/UnitNavigation.astro';
import { loadCaseDocument } from '../../../lib/content/case-document';
import { loadStructuredContent } from '../../../lib/content/loaders';
import { loadMobileReadingPrototype } from '../../../lib/content/reading-prototype';
import { loadHierarchy } from '../../../lib/content/hierarchy';
import { evidenceKindLabel, quotationStatusLabel, sourceStatusLabel } from '../../../lib/content/labels';
import { route } from '../../../lib/routes';

/**
 * The My Lai child screens (#51).
 *
 * One route per conceptual unit, generated from the screen graph rather than from
 * this file's own idea of what the case contains. Each branch below renders one
 * canonical selection: the graph decides which units exist, cases.json and the
 * case Markdown decide what they say.
 */
export async function getStaticPaths() {
  const { cases } = await loadStructuredContent();
  const sorted = [...cases.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));
  const hierarchy = loadHierarchy(sorted, loadMobileReadingPrototype(sorted));
  return hierarchy.describe('my-lai').children.map((child) => ({
    params: { unit: child.route.split('/').at(-1) as string },
    props: { unitId: child.id },
  }));
}

interface Props { unitId: string }
const { unitId } = Astro.props;
const { cases: caseFile, glossary } = await loadStructuredContent();
const cases = [...caseFile.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));
const prototype = loadMobileReadingPrototype(cases);
const hierarchy = loadHierarchy(cases, prototype);
const description = hierarchy.describe(unitId);
const record = cases.find((candidate) => candidate.id === prototype.case.caseId);
if (!record) throw new Error('The My Lai case record is missing from cases.json.');
const glossaryPrefix = `${route('/glossary')}#glossary-`;
const document = await loadCaseDocument(record, glossary, { glossaryHrefPrefix: glossaryPrefix });

const essentialChronology = prototype.case.essentialChronologyIndexes
  .map((index) => record.chronology[index])
  .filter((entry) => entry !== undefined);
const focalEvidence = record.evidence[prototype.case.focalEvidenceIndex];
if (!focalEvidence) throw new Error('The My Lai focal evidence index is outside the case record.');
const narrativeSections = record.sections.filter((section) => prototype.case.essentialSectionKeys.includes(section.key));
const depthSections = record.sections.filter((section) => prototype.case.depthSectionKeys.includes(section.key));
const { unit } = description;
---
<PublicationLayout
  title={`${unit.label} · My Lai · Ares`}
  description={unit.question}
  currentLabel={`Guided reading · My Lai · ${unit.label}`}
  currentPath="/cases/my-lai-massacre"
>
  <div class="case-page page-frame">
    <a class="case-index-link" href={route('/cases/my-lai-massacre')}>My Lai / case overview</a>

    <article class="case-study case-study--standalone reading-case" aria-labelledby="unit-title" style="--weight-regular:var(--weight-text)">
      <header class="case-header reading-case__header">
        <p class="case-locator">{record.openingContext}</p>
        <h1 id="unit-title">{unit.title}</h1>
        <p class="case-argument"><span>My Lai · {unit.label}</span>{unit.cognitiveJob}</p>
      </header>

      <ReadingLocation description={description} />

      {unitId === 'my-lai-orientation' && (
        <section id="orientation" class="reading-unit reading-unit--lead" data-reading-section data-reading-label="Orientation" aria-labelledby="orientation-title">
          <h2 id="orientation-title">What happened, and why this case is here</h2>
          <p>{prototype.case.orientation}</p>
        </section>
      )}

      {unitId === 'my-lai-narrative' && narrativeSections.map((section) => {
        const content = document.sections[section.key];
        if (!content) throw new Error(`The My Lai narrative unit cannot find section ${section.key}.`);
        return (
          <section id="core-narrative" class="case-section narrative-section reading-unit" data-reading-section data-reading-label="Core narrative" aria-labelledby="core-narrative-title">
            <h2 id="core-narrative-title">{content.title}</h2>
            <p class="section-authorship">{section.authorship}</p>
            <div class="prose" set:html={content.html}></div>
          </section>
        );
      })}

      {unitId === 'my-lai-key-evidence' && (
        <section id="key-evidence" class="reading-unit" data-reading-section data-reading-label="Key evidence" aria-labelledby="key-evidence-title">
          <h2 id="key-evidence-title">Four events to hold in view</h2>
          <ol class="essential-chronology">
            {essentialChronology.map((entry) => (
              <li>
                <p class="essential-chronology__date">{entry.dateLabel}</p>
                <p>{entry.text}</p>
                <p class="source-status">Trace status: {sourceStatusLabel(entry.sourceStatus)}.</p>
              </li>
            ))}
          </ol>
          <p class="source-status">These four entries are a selection from the case's complete chronology, which the scholarly-depth screen renders in full.</p>
          <aside class="evidence-provenance evidence-provenance--focal" aria-label="Principal testimony provenance">
            <p class="evidence-provenance__kind">Principal evidence · {evidenceKindLabel(focalEvidence.kind)}</p>
            <p><strong>{focalEvidence.speaker}</strong> — {focalEvidence.context}</p>
            <p>Trace status: {sourceStatusLabel(focalEvidence.sourceStatus)}; quotation status: {quotationStatusLabel(focalEvidence.quotationStatus)}.</p>
          </aside>
        </section>
      )}

      {unitId === 'my-lai-finding' && (
        <section id="analysis" class="reading-unit reading-unit--analysis" data-reading-section data-reading-label="Analytical finding" aria-labelledby="analysis-title">
          <h2 id="analysis-title">What the case can support</h2>
          <p>{prototype.case.finding}</p>
          <aside class="integrity-note" role="note"><strong>Limitation.</strong> {prototype.case.limitation}</aside>
        </section>
      )}

      {unitId === 'my-lai-scholarly-depth' && (
        <section id="full-scholarly-depth" class="reading-unit reading-unit--choice" data-reading-section data-reading-label="Content note" aria-labelledby="content-note-title">
          <h2 id="content-note-title">Before you read the complete record</h2>
          <p>The sections below include extended detail of the killing, the cover-up and the courts-martial. Nothing here is needed to understand the case's analytical finding, which the essential units already state in full.</p>
          <a class="pause-link" href={route('/cases/my-lai-massacre/finding')}>Return to the analytical finding instead</a>
        </section>
      )}

      <UnitCaveats unit={unit} />

      {unitId === 'my-lai-scholarly-depth' && depthSections.map((section) => {
        const content = document.sections[section.key];
        if (!content) throw new Error(`The My Lai depth unit cannot find section ${section.key}.`);
        const headingId = `${record.id}-section-${section.key.toLowerCase()}`;
        return (
          <section class:list={['case-section', section.kind === 'chronology' ? 'chronology-section' : 'analytical-section']} aria-labelledby={headingId}>
            <h2 id={headingId}>{content.title}</h2>
            <p class="section-authorship">{section.authorship}</p>
            {section.note && <p class="section-note">{section.note}</p>}
            {section.kind === 'chronology' ? <ChronologySpine record={record} /> : <div class="prose" set:html={content.html} />}
          </section>
        );
      })}

      <UnitNavigation description={description} />
    </article>
  </div>
</PublicationLayout>
