---
import PublicationLayout from '../../layouts/PublicationLayout.astro';
import PageIntro from '../../components/publication/PageIntro.astro';
import Comparison from '../../components/cases/Comparison.astro';
import DurationScale from '../../components/figures/DurationScale.astro';
import ReadingLocation from '../../components/reading/ReadingLocation.astro';
import UnitCaveats from '../../components/reading/UnitCaveats.astro';
import UnitNavigation from '../../components/reading/UnitNavigation.astro';
import { loadSectionHtml, loadStructuredContent } from '../../lib/content/loaders';
import { loadMobileReadingPrototype } from '../../lib/content/reading-prototype';
import { loadHierarchy } from '../../lib/content/hierarchy';
import { route } from '../../lib/routes';

/**
 * The comparison child screens (#51): one controlled dimension, or the complete
 * scholarly comparison. Neither is stacked below the overview any more, so the
 * phone reader integrates one comparison at a time by choosing to.
 */
export async function getStaticPaths() {
  const { cases } = await loadStructuredContent();
  const sorted = [...cases.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));
  const hierarchy = loadHierarchy(sorted, loadMobileReadingPrototype(sorted));
  return hierarchy.describe('comparison').children.map((child) => ({
    params: { unit: child.route.split('/').at(-1) as string },
    props: { unitId: child.id },
  }));
}

interface Props { unitId: string }
const { unitId } = Astro.props;
const { cases: caseFile, glossary } = await loadStructuredContent();
const cases = [...caseFile.cases].sort((a, b) => a.sortKey.localeCompare(b.sortKey));
const prototype = loadMobileReadingPrototype(cases);
const hierarchy = loadHierarchy(cases, prototype);
const description = hierarchy.describe(unitId);
const { unit } = description;
const dimensionCases = prototype.comparison.dimension.caseIds
  .map((id) => cases.find((record) => record.id === id))
  .filter((record) => record !== undefined);
// Only the depth screen renders glossary-cued prose, so only it ships the dialog.
const depthProps = unitId === 'comparison-scholarly-depth' ? { glossary } : {};
const analysis = unitId === 'comparison-scholarly-depth'
  ? await loadSectionHtml('comparative-analysis', glossary, { stripFirstHeading: true, glossaryHrefPrefix: `${route('/glossary')}#glossary-` })
  : '';
---
<PublicationLayout
  title={`${unit.label} · Comparison · Ares`}
  description={unit.question}
  currentLabel={`Guided reading · Comparison · ${unit.label}`}
  currentPath="/comparison"
  {...depthProps}
>
  <article class="chapter-page page-frame">
    <PageIntro title={unit.title} description={unit.cognitiveJob} />

    <ReadingLocation description={description} />

    <aside class="integrity-note reading-unit dimension-view__intro" role="note"><strong>Method note.</strong> {prototype.comparison.warning}</aside>

    {unitId === 'comparison-tempo' && (
      <section id="tempo" class="dimension-view" data-reading-section data-reading-label="Dimension · tempo" aria-labelledby="tempo-title">
        <div class="dimension-view__intro">
          <h2 id="tempo-title">{prototype.comparison.dimension.title}</h2>
          <p><strong>Question:</strong> {prototype.comparison.dimension.question}</p>
          <p>{prototype.comparison.dimension.takeaway}</p>
        </div>
        <ol class="dimension-list">
          {dimensionCases.map((record) => (
            <li>
              <strong>{record.navTitle}</strong>
              <span>{record.displayPeriod} · {record.classification.display}</span>
            </li>
          ))}
        </ol>
      </section>
    )}

    {unitId === 'comparison-scholarly-depth' && (
      <div id="full-comparison-depth" class="scholarly-depth comparison-depth" data-reading-section data-reading-label="Full scholarly comparison" style="min-width:0;max-width:100%">
        <DurationScale cases={cases} />
        <section id="full-matrix" aria-labelledby="full-matrix-title" style="min-width:0;max-width:100%">
          <h2 id="full-matrix-title">Complete comparison matrix</h2>
          <Comparison cases={cases} />
        </section>
        <section id="full-analysis" aria-labelledby="full-analysis-title" style="min-width:0;max-width:100%;overflow-wrap:anywhere">
          <h2 id="full-analysis-title">Full comparative-analysis manuscript</h2>
          <div class="analysis-manuscript prose" set:html={analysis}></div>
        </section>
      </div>
    )}

    <UnitCaveats unit={unit} />

    <UnitNavigation description={description} />
  </article>
</PublicationLayout>
